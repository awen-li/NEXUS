digraph nexus_demo {
  rankdir=LR;
  graph [fontname="Helvetica"];
  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];
  "cpython:nexus_bench.b3_extension_plugin" [shape=box,style=rounded];
  "native:_nexus_bench_ext" [shape=box,style=rounded];
  "native:nexus_transform_plugin" [shape=box,style=rounded];
  "cpython:nexus_bench.b3_extension_plugin" -> "native:_nexus_bench_ext" [label="direct"];
  "native:_nexus_bench_ext" -> "native:nexus_transform_plugin" [label="dynamic_load"];
}
